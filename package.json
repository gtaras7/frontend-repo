{
  "name": "cardioguard-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint .",
    "lint:fix": "next typegen && eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "prepare": "husky",
    "typegen": "next typegen"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "next-intl": "^4.14.4",
    "@tanstack/react-query": "^5.102.8",
    "zustand": "^5.0.15",
    "lucide-react": "^1.45.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "typescript-eslint": "^8.70.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "@playwright/test": "^1.63.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}

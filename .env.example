# Copy to .env.local. Never commit real values.

# NestJS API base URL. All patient data, auth and AI calls go through here.
# Production builds require https:// (enforced in lib/api/client.ts).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opt-in local/E2E stubs for bootstrap, consent, demo registration and baseline while NestJS endpoints
# are unavailable. Must be exactly "1" to enable; ignored in production builds.
# Leave unset to call existing real bootstrap/consent APIs. Account/baseline actions
# remain unavailable until their backend contracts are approved; no endpoint is guessed.
NEXT_PUBLIC_MOCK_ONBOARDING=1
